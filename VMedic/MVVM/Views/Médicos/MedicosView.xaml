<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VMedic.MVVM.Views.MedicosView"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             Shell.BackgroundColor="{StaticResource Primary}"
             Title="Médicos">

    <Shell.TitleView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label x:Name="titulo"
                   Text="Médicos"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="20" />
            <ImageButton x:Name="btn_habilitarBuscar"
                         Grid.Column="1"
                         HeightRequest="50"
                         WidthRequest="50"
                         Padding="12.5"
                         Source="ic_search.png"
                         HorizontalOptions="End"
                         VerticalOptions="Center"
                         Clicked="btn_habilitarBuscar_Clicked">
            </ImageButton>
            <Grid x:Name="SearchMedico"
                  IsVisible="False"
                  Grid.ColumnSpan="2">
                <Entry x:Name="searchBox_Medico"
                       TextChanged="searchBox_Medico_TextChanged"
                       HorizontalOptions="Fill"
                       TextColor="White" />
                <ImageButton x:Name="btn_cancel_text"
                             HorizontalOptions="End"
                             HeightRequest="50"
                             WidthRequest="50"
                             Padding="15"
                             Source="close_blanc.png"
                             Clicked="btn_cancel_text_Clicked" />
            </Grid>
        </Grid>
    </Shell.TitleView>

    <Grid>
        <core:SfBusyIndicator x:Name="busyIndicator"
                              Title="Cargando Médicos..."
                              Grid.Row="1"
                              Margin="0,5"
                              AnimationType="Cupertino"
                              CompressedLayout.IsHeadless="True"
                              FontSize="12"
                              HorizontalOptions="Fill"
                              IndicatorColor="#2d3e50"
                              IsRunning="{Binding Indicador, Mode=TwoWay}"
                              OverlayFill="#50ffffff"
                              SizeFactor="1"
                              VerticalOptions="Fill">
            <RefreshView x:Name="refresh"
                         Grid.Row="1"
                         Refreshing="refresh_Refreshing"
                         IsRefreshing="{Binding IsRefreshing}">
                <ScrollView Grid.Row="1"
                            x:Name="scroll_container"
                            CompressedLayout.IsHeadless="True"
                            Scrolled="scroll_container_Scrolled">
                    <VerticalStackLayout x:Name="List_Medicos"
                                         VerticalOptions="Fill"
                                         HorizontalOptions="Fill" />
                </ScrollView>
            </RefreshView>
        </core:SfBusyIndicator>
        <Label Text="No hay resultados"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               FontAttributes="Bold"
               FontSize="18"
               IsVisible="{Binding TextoAviso}" />
        <Border x:Name="containerbtn_agregaremedicos"
                Grid.Row="1"
                BackgroundColor="{StaticResource Primary}"
                Stroke="Transparent"
                StrokeShape="Ellipse"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,10,10"
                HeightRequest="50"
                WidthRequest="50">
            <Image x:Name="btn_agregarmedicos"
                   HeightRequest="25"
                   Source="add_blanc.png"
                   WidthRequest="25" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="AgregarMedicos_Tapped" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentPage>