<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VMedic.MVVM.Views.Sincronizaciones.SincronizacionView"
             Shell.BackgroundColor="{StaticResource Secondary}">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Color="#90c3e3"
                          Offset="0.0" />
            <GradientStop Color="#eafafc"
                          Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Shell.TitleView>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="50" />
            </Grid.ColumnDefinitions>
            <Label Text="Sincronizar Pendientes"
                   VerticalOptions="Center"
                   TextColor="White"
                   FontAttributes="Bold"
                   FontSize="18" />
            <ImageButton Grid.Column="1"
                         Source="up_load.png"
                         HeightRequest="50"
                         WidthRequest="50"
                         Padding="12.5" />
        </Grid>
    </Shell.TitleView>

    <Grid>
        <ScrollView x:Name="Scroll">
            <VerticalStackLayout x:Name="List_Pendientes"
                                 VerticalOptions="Fill"
                                 HorizontalOptions="Fill"
                                 SizeChanged="Scroll_SizeChanged">
                <Border ClassId="Modulo"
                        Margin="15,10"
                        StrokeShape="RoundRectangle 10"
                        Stroke="Transparent">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#f4fbfd"
                                          Offset="0.0" />
                            <GradientStop Color="#f8fdff"
                                          Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border Stroke="Transparent"
                                BackgroundColor="#42b7a6">
                            <Label Text="VISITAS (5)"
                                   Margin="10"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="White" />
                        </Border>

                        <VerticalStackLayout Grid.Row="1">
                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Visita No Efectiva"
                                           FontAttributes="Bold"
                                           BackgroundColor="{StaticResource menuPrincipalVerde}" />
                                    <Label Padding="10, 2.5"
                                           Text="2026/07/28 04:48:26" />
                                    <Label Padding="10, 5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="Establecimiento Cerrado"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Entrega de Promocionales"
                                           BackgroundColor="{StaticResource menuPrincipalAzul}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5"
                                           Text="2026-07-28 04:48:26" />
                                    <Label Padding="10,5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="Recetario"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Lugares o Eventos"
                                           BackgroundColor="{StaticResource menuPrincipalVerde}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5"
                                           Text="2026-07-28 04:48:26" />
                                    <Label Padding="10,5"
                                           Text="Oficinas Centrales" />
                                    <Label Margin="10,2.5,10,10"
                                           Text="Entrada. Registro de entrada"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    Padding="0,0,0,10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Entrega de Evaluación Profesional"
                                           BackgroundColor="{StaticResource menuPrincipalAzul}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5"
                                           Text="2026-07-28 04:48:26" />
                                    <Label Padding="10,5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,7.5"
                                           Text="Evaluaciones"
                                           BackgroundColor="{StaticResource Yellow200Accent}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5"
                                           Text="NUTRILON HYPO-ALLERGENIC (H.A.) 400GRS"
                                           HorizontalTextAlignment="End" />
                                    <Label Margin="10,2.5"
                                           Text="NUTRILON 2 C/INMUNOFORTIS 400 GRS LATA"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Otros"
                                           BackgroundColor="{StaticResource menuPrincipalVerde}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5"
                                           Text="2026-07-28 04:48:26" />
                                    <Label Padding="10,5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="Visita de Rutina"
                                           HorizontalTextAlignment="End" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border ClassId="Modulo"
                        Margin="15,10"
                        StrokeShape="RoundRectangle 10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#f4fbfd"
                                          Offset="0.0" />
                            <GradientStop Color="#f8fdff"
                                          Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border BackgroundColor="#42b7a6">
                            <Label Text="MÉDICOS (2)"
                                   Margin="10"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="White" />
                        </Border>

                        <VerticalStackLayout Grid.Row="1">
                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Actualizar Médico"
                                           BackgroundColor="{StaticResource menuPrincipalVerde}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,7.5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,5"
                                           BackgroundColor="{StaticResource Yellow200Accent}"
                                           Text="Días Hábiles"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="2026-07-28 - 2026-08-09" />

                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Registrar Nuevo Médico"
                                           BackgroundColor="{StaticResource menuPrincipalAzul}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,7.5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,5"
                                           Text="Una Sola Visita"
                                           BackgroundColor="{StaticResource Yellow200Accent}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="2026-07-28" />

                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border ClassId="Modulo"
                        Margin="15,10"
                        StrokeShape="RoundRectangle 10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">
                            <GradientStop Color="#f4fbfd"
                                          Offset="0.0" />
                            <GradientStop Color="#f8fdff"
                                          Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Border BackgroundColor="#42b7a6">
                            <Label Text="PLANIFICACIÓN (1)"
                                   Margin="10"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   TextColor="White" />
                        </Border>

                        <VerticalStackLayout Grid.Row="1">
                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Actualizar Control de Visita"
                                           BackgroundColor="{StaticResource menuPrincipalVerde}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,7.5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,5"
                                           Text="Una Sola Visita"
                                           BackgroundColor="{StaticResource Yellow200Accent}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="2026-07-28" />

                                </VerticalStackLayout>
                            </Border>

                            <Border Margin="15, 10"
                                    StrokeShape="10">
                                <VerticalStackLayout>
                                    <Label Padding="10"
                                           Text="Deshabilitar Control de Visita"
                                           BackgroundColor="{StaticResource menuPrincipalAzul}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,7.5"
                                           Text="Carlos Samuel Menéndez Hernández" />
                                    <Label Padding="10,5"
                                           Text="Una Sola Visita"
                                           BackgroundColor="{StaticResource Yellow200Accent}"
                                           FontAttributes="Bold" />
                                    <Label Padding="10,2.5,10,10"
                                           Text="2026-07-28" />

                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout x:Name="Container_Btns"
                               IsVisible="False"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               Spacing="10"
                               Margin="15">
            <Border HeightRequest="40"
                    WidthRequest="40"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}">
                <ImageButton x:Name="btn_bajar"
                             Clicked="btn_bajar_Clicked"
                             Padding="10">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="Icon"
                                         Glyph="&#xE806;"
                                         Size="20"
                                         Color="White" />
                    </ImageButton.Source>
                </ImageButton>
            </Border>

            <Border HeightRequest="40"
                    WidthRequest="40"
                    StrokeShape="Ellipse"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource Primary}">
                <ImageButton x:Name="btnSubir"
                             Rotation="180"
                             Clicked="btnSubir_Clicked"
                             Padding="10">
                    <ImageButton.Source>
                        <FontImageSource FontFamily="Icon"
                                         Glyph="&#xE806;"
                                         Size="20"
                                         Color="White" />
                    </ImageButton.Source>
                </ImageButton>
            </Border>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
