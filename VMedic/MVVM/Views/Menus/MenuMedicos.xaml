<?xml version="1.0" encoding="utf-8" ?>
<mopups:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                  x:Class="VMedic.MVVM.Views.Menus.MenuMedicos"
                  xmlns:mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
                  xmlns:mopupsanim="clr-namespace:Mopups.Animations;assembly=Mopups"
                  BackgroundColor="#20000000"
                  Title="MenuMedicos">

    <mopups:PopupPage.Animation>
        <mopupsanim:ScaleAnimation x:Name="animation_status"
                                   DurationIn="200"
                                   PositionIn="Bottom"
                                   PositionOut="Bottom"
                                   ScaleIn="0.7"
                                   ScaleOut="0.7" />
    </mopups:PopupPage.Animation>

    <Border x:Name="Gridcontenedor"
          BackgroundColor="White"
          HorizontalOptions="End"
          VerticalOptions="End"
          Margin="0,0,10,60" StrokeShape="RoundRectangle 10">
        <VerticalStackLayout>
            <Label Text="Agregar Nuevo Médico"
                   Padding="20,10"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="End"
                   FontSize="14"
                   FontAttributes="Bold">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="NewMedico_Tapped" />
                </Label.GestureRecognizers>
            </Label>
            <Grid Padding="10,10,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Image Source="circle.png"
                       HeightRequest="20"
                       WidthRequest="20"
                       VerticalOptions="Center" />
                <Label x:Name="lbl_cantidadPendientes"
                       Text="0"
                       TextColor="White"
                       WidthRequest="20"
                       HorizontalTextAlignment="Center"
                       FontAttributes="Bold"
                       FontSize="14" />
                <Label Grid.Column="1"
                       Text="Enviar Médicos Pendientes"
                       VerticalTextAlignment="Center"
                       FontSize="14"
                       Margin="5,0,0,0"
                       FontAttributes="Bold" />
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="EnviarPendientes_Tapped" />
                </Grid.GestureRecognizers>
            </Grid>
        </VerticalStackLayout>
    </Border>
</mopups:PopupPage>
